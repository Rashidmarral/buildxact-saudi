APP_NAME="BuildXact Saudi"
APP_URL=http://localhost:8000
APP_ENV=local
APP_DEBUG=true
APP_KEY=change-this-to-a-random-32-char-secret

# Database driver: sqlite | mysql
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildxact_saudi
DB_USERNAME=root
DB_PASSWORD=

# Default subscription trial length (days)
TRIAL_DAYS=14

# Currency shown across the platform
DEFAULT_CURRENCY=SAR

# Payment gateway (stubbed integration point for Saudi gateways: Moyasar, HyperPay, PayTabs, Tap)
PAYMENT_GATEWAY=manual
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
