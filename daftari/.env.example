APP_NAME=Daftari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

TRIAL_DAYS=14
DEFAULT_CURRENCY=SAR
PAYMENT_GATEWAY=manual

# Document PDF downloads render through a real Chromium engine (not dompdf)
# so Arabic text shapes correctly — see App\Services\ChromiumPdfRenderer.
# Run `npm install && npx playwright install --with-deps chromium` once on
# the server. Only set CHROMIUM_EXECUTABLE_PATH if you need to point at a
# specific Chrome/Chromium binary instead of Playwright's managed install.
# CHROMIUM_EXECUTABLE_PATH=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log writes outgoing mail to storage/logs/laravel.log instead
# of actually delivering it — swap in real SMTP credentials (and set
# MAIL_MAILER=smtp) before relying on invoice/quotation emails in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@daftari.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave SENTRY_LARAVEL_DSN empty to disable error monitoring entirely (the
# default for local/dev). Set it to your project's DSN in production to
# start reporting uncaught exceptions to Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Daftari's own legal/billing identity, shown on the subscription receipts
# issued to companies for their plan payments. Leave the VAT/CR number
# blank until you have real registered numbers for this instance — the
# receipt simply omits those lines rather than showing a fake one.
DAFTARI_BILLING_NAME="Daftari"
DAFTARI_BILLING_VAT_NUMBER=
DAFTARI_BILLING_CR_NUMBER=
DAFTARI_BILLING_ADDRESS=
DAFTARI_BILLING_EMAIL=

VITE_APP_NAME="${APP_NAME}"
